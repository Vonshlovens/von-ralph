#!/usr/bin/env bash
set -o pipefail

if ! command -v jq &>/dev/null; then
  echo "Error: jq is not installed. Install it with: sudo apt install jq"
  exit 1
fi

DEFAULT_PROMPT='/tackle choose a todo. If you come across tasks that go out of scope of the todo, make new kanban todos.

Update specs if needed — they are the current source of truth. Rules:

1. NEVER delete planned feature descriptions, API designs, or architectural blueprints from specs. If something isn'\''t implemented yet, mark it as "Planned" — don'\''t remove it. The design detail is the whole point.

2. DO fix stale file paths, wrong component names, and inaccurate descriptions of *implemented* code.

3. If you touch a spec, clearly separate "Implemented" sections from "Planned" sections so the next agent knows what exists vs what'\''s designed but not built.

4. If something is impossible to implement or has conflicting instructions, research current practices and fix the discrepancy — but preserve the design intent.

5. Never remove cross-references between specs, even to planned sections — mark them as "(Planned)" instead.

When you are done, ensure you have added at least one (1) new todo to the kanban.'

PROMPT=""
HARNESS="claude"
MODEL=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    -H|--harness) HARNESS="$2"; shift 2 ;;
    -m|--model)   MODEL="$2"; shift 2 ;;
    -h|--help)
      cat <<'USAGE'
Usage: alph [prompt] [options]
Single non-looping headless run.

Options:
  -H, --harness <name>   claude (default), codex, opencode, gh
  -m, --model <model>    Override harness default model
USAGE
      exit 0
      ;;
    *) PROMPT="$1"; shift ;;
  esac
done

if [ -z "$PROMPT" ]; then
  PROMPT="$DEFAULT_PROMPT"
fi

case "$HARNESS" in
  claude)   DEFAULT_MODEL="opus" ;;
  codex)    DEFAULT_MODEL="gpt-5.5" ;;
  opencode) DEFAULT_MODEL="openai/gpt-5.5" ;;
  gh)       DEFAULT_MODEL="claude-sonnet-4.6" ;;
  *) echo "Error: unknown harness '$HARNESS'"; exit 1 ;;
esac
[ -z "$MODEL" ] && MODEL="$DEFAULT_MODEL"

cleanup() {
  echo " Stopped."
  pkill -TERM -P $$ 2>/dev/null
  sleep 0.1
  pkill -KILL -P $$ 2>/dev/null
  exit 0
}

trap cleanup INT TERM

case "$HARNESS" in
  claude)
    claude -p --model="$MODEL" --dangerously-skip-permissions \
      "$PROMPT" \
      --print --output-format=stream-json --verbose </dev/null 2>/dev/null \
    | jq -r '
      if .type == "assistant" then
        .message.content[]? |
        if .type == "text" then
          "💬 " + .text
        elif .type == "tool_use" then
          "🔧 " + .name + ": " + (.input | tostring | .[0:150])
        else empty end
      elif .type == "user" then
        .message.content[]? |
        if .type == "tool_result" then
          "📋 " + (.content | tostring | .[0:200])
        else empty end
      else empty end
    '
    ;;

  codex)
    codex exec --json --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check \
      -m "$MODEL" -c model_reasoning_effort="xhigh" \
      "$PROMPT" </dev/null 2>/dev/null \
    | jq -r '
      if .type == "item.completed" then
        .item as $i |
        if $i.type == "agent_message" then "💬 " + ($i.text // "")
        elif $i.type == "command_execution" then
          "🔧 shell: " + (($i.command // "") | tostring | .[0:150])
            + "\n📋 [exit " + (($i.exit_code // "?") | tostring) + "] "
            + (($i.aggregated_output // "") | tostring | .[0:200])
        elif $i.type == "file_change" then
          "🔧 file_change: " + (($i.changes // []) | map((.kind // "?") + " " + (.path // "?")) | join(", "))
        else empty end
      else empty end
    '
    ;;

  opencode)
    opencode run --format json --dangerously-skip-permissions \
      --model "$MODEL" --variant max --print-logs --log-level ERROR \
      "$PROMPT" </dev/null 2>/dev/null \
    | jq -r '
      if .type == "text" then
        "💬 " + ((.part.text // .text // "") | tostring)
      elif .type == "tool_use" and (.part.state.status // "") == "completed" then
        "🔧 " + (.part.tool // "?") + ": " + ((.part.state.input // {}) | tostring | .[0:150])
          + "\n📋 " + ((.part.state.output // "") | tostring | .[0:200])
      elif .type == "step_finish" then
        "✅ step_finish reason=" + ((.part.reason // "?") | tostring)
      elif .type == "error" then
        "⚠️  error: " + ((.error.data.message // .error.message // .error.name // "") | tostring | .[0:300])
      else empty end
    '
    ;;

  gh)
    copilot -p "$PROMPT" \
      --allow-all-tools --allow-all-paths --allow-all-urls \
      --add-dir "$(pwd)" --model "$MODEL" --effort high \
      --output-format json --no-color </dev/null 2>/dev/null \
    | jq -r '
      . as $e |
      (.type // .event // "") as $t |
      if $t == "assistant.message" then
        "💬 " + ((.data.content // "") | tostring)
      elif ($t == "assistant.message_delta") then
        empty
      elif ($t == "result") then
        "✅ result exit=" + ((.exitCode // .data.exitCode // "?") | tostring)
      elif ($t == "assistant" or $t == "message" or $t == "text") then
        "💬 " + ((.text // .content // "") | tostring)
      elif ($t == "tool_use" or $t == "tool_call" or $t == "tool.call") then
        "🔧 " + ((.name // .tool // "?") | tostring) + ": "
          + (((.input // .arguments // {}) | tostring) | .[0:150])
      elif ($t == "tool_result" or $t == "tool.result") then
        "📋 " + (((.output // .content // "") | tostring) | .[0:200])
      elif ($t == "error" or .error) then
        "⚠️  " + (((.error // .message // "") | tostring) | .[0:200])
      elif ($t | startswith("session.")) or ($t == "user.message") or ($t == "assistant.turn_start") or ($t == "assistant.turn_end") or ($t == "assistant.message_start") then
        empty
      else
        "ℹ️  " + ($e | tostring | .[0:200])
      end
    '
    ;;
esac
