#!/usr/bin/env bash
set -o pipefail

if ! command -v jq &>/dev/null; then
  echo "Error: jq is not installed. Install it with: sudo apt install jq"
  exit 1
fi

DEFAULT_PROMPT='/tackle choose a todo. If you come across tasks that go out of scope of the todo, make new kanban todos.

Update specs if needed — they are the current source of truth. Rules:

1. NEVER delete planned feature descriptions, API designs, or architectural blueprints from specs. If something isn'\''t implemented yet, mark it as "Planned" — don'\''t remove it. The design detail is the whole point.

2. DO fix stale file paths, wrong component names, and inaccurate descriptions of *implemented* code.

3. If you touch a spec, clearly separate "Implemented" sections from "Planned" sections so the next agent knows what exists vs what'\''s designed but not built.

4. If something is impossible to implement or has conflicting instructions, research current practices and fix the discrepancy — but preserve the design intent.

5. Never remove cross-references between specs, even to planned sections — mark them as "(Planned)" instead.

When you are done, ensure you have added at least one (1) new todo to the kanban.'

usage() {
  cat <<'USAGE'
Usage: ralph [prompt] [max_runs] [options]

Arguments:
  prompt       The prompt to send each loop (default: built-in /tackle prompt)
  max_runs     Max iterations (default: unlimited). Can be first arg if numeric.

Options:
  -d, --dir <path>        Working directory (default: current dir)
  -m, --model <model>     Model to use (default depends on harness)
  -n, --name <name>       Name this ralph instance (default: auto-generated)
  -H, --harness <name>    Agent CLI to drive: claude (default), codex, opencode, gh
  --marathon              Enable rate-limit detection with 30min sleep
  --no-log                Disable log files (output to terminal only)
  -h, --help              Show this help

Harness defaults (override with -m):
  claude    opus
  codex     gpt-5.5            (reasoning: xhigh)
  opencode  openai/gpt-5.5                    (variant: max)
  gh        claude-sonnet-4.6  (effort:    high)

Examples:
  ralph 10                                          # 10 runs with default prompt
  ralph "See AGENT_PROMPT.md" 10                    # Custom prompt, 10 runs
  ralph "Fix all lint errors" -d ~/my-project -n lint-fixer
  ralph --marathon                                  # Infinite with rate-limit recovery
  ralph "Refactor utils" -H codex                   # Drive OpenAI codex instead
  ralph "Add tests" -H opencode -m openai/gpt-5.5
USAGE
  exit 0
}

# --- Parse args ---
PROMPT=""
MAX_RUNS=0
WORK_DIR=""
MODEL=""
MODEL_EXPLICIT=false
RALPH_NAME=""
HARNESS="claude"
MARATHON=false
NO_LOG=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage ;;
    -d|--dir) WORK_DIR="$2"; shift 2 ;;
    -m|--model) MODEL="$2"; MODEL_EXPLICIT=true; shift 2 ;;
    -n|--name) RALPH_NAME="$2"; shift 2 ;;
    -H|--harness) HARNESS="$2"; shift 2 ;;
    --marathon) MARATHON=true; shift ;;
    --no-log) NO_LOG=true; shift ;;
    -*)
      echo "Unknown option: $1"
      usage
      ;;
    *)
      # If first positional is a number and no prompt yet, treat as max_runs (use default prompt)
      if [ -z "$PROMPT" ] && [[ "$1" =~ ^[0-9]+$ ]]; then
        MAX_RUNS="$1"
        PROMPT="$DEFAULT_PROMPT"
      elif [ -z "$PROMPT" ]; then
        PROMPT="$1"
      elif [ "$MAX_RUNS" -eq 0 ] 2>/dev/null && [[ "$1" =~ ^[0-9]+$ ]]; then
        MAX_RUNS="$1"
      else
        echo "Unexpected argument: $1"
        usage
      fi
      shift
      ;;
  esac
done

# Use default prompt if none provided
if [ -z "$PROMPT" ]; then
  PROMPT="$DEFAULT_PROMPT"
fi

# Validate harness and resolve default model
case "$HARNESS" in
  claude)   DEFAULT_MODEL="opus" ;;
  codex)    DEFAULT_MODEL="gpt-5.5" ;;
  opencode) DEFAULT_MODEL="openai/gpt-5.5" ;;
  gh)       DEFAULT_MODEL="claude-sonnet-4.6" ;;
  *)
    echo "Error: unknown harness '$HARNESS' (expected: claude, codex, opencode, gh)"
    exit 1
    ;;
esac
if [ -z "$MODEL" ]; then
  MODEL="$DEFAULT_MODEL"
fi

# Check that the harness binary is available
case "$HARNESS" in
  claude)   HARNESS_BIN="claude" ;;
  codex)    HARNESS_BIN="codex" ;;
  opencode) HARNESS_BIN="opencode" ;;
  gh)       HARNESS_BIN="copilot" ;;
esac
if ! command -v "$HARNESS_BIN" &>/dev/null; then
  echo "Error: harness '$HARNESS' requires the '$HARNESS_BIN' binary on PATH."
  case "$HARNESS" in
    codex)    echo "  Install: npm install -g @openai/codex" ;;
    opencode) echo "  Install: see https://opencode.ai" ;;
    gh)       echo "  Install: npm install -g @github/copilot" ;;
  esac
  exit 1
fi

# --- Setup ---
RALPH_DIR="$HOME/.ralph"
LOG_DIR="$RALPH_DIR/logs"
PID_DIR="$RALPH_DIR/pids"
mkdir -p "$LOG_DIR" "$PID_DIR"

if [ -z "$RALPH_NAME" ]; then
  RALPH_NAME="ralph-$(date +%Y%m%d-%H%M%S)-$$"
fi

LOG_FILE="$LOG_DIR/${RALPH_NAME}.log"
PID_FILE="$PID_DIR/${RALPH_NAME}.pid"
META_FILE="$PID_DIR/${RALPH_NAME}.meta"
RATE_LIMIT_SLEEP=1800

# Write PID file
echo $$ > "$PID_FILE"

# Write metadata
cat > "$META_FILE" <<EOF
name=$RALPH_NAME
pid=$$
prompt=$PROMPT
max_runs=$MAX_RUNS
current_run=0
model=$MODEL
harness=$HARNESS
work_dir=${WORK_DIR:-$(pwd)}
marathon=$MARATHON
started=$(date -Iseconds)
EOF

log() {
  local msg="[$(date '+%H:%M:%S')] $1"
  if [ "$NO_LOG" = false ]; then
    echo "$msg" | tee -a "$LOG_FILE"
  else
    echo "$msg"
  fi
}

cleanup() {
  # Prevent re-entry from repeated Ctrl-C
  trap - INT TERM
  log "🛑 Ralph '$RALPH_NAME' stopped after $RUNS_COMPLETED runs."
  rm -f "$PID_FILE"
  # Kill child processes only (not ourselves)
  pkill -TERM -P $$ 2>/dev/null
  wait 2>/dev/null
  exit 0
}

trap cleanup INT TERM

# --- Per-harness invocation ---
# Each branch runs the CLI in non-interactive / full-autonomy mode and pipes
# JSONL events through jq to produce a uniform line-oriented log.
run_harness() {
  local harness="$1" model="$2" prompt="$3"
  case "$harness" in
    claude)
      claude -p --model="$model" --dangerously-skip-permissions \
        "$prompt" \
        --print --output-format=stream-json --verbose </dev/null 2>/dev/null \
      | jq --unbuffered -r '
        if .type == "assistant" then
          .message.content[]? |
          if .type == "text" then
            "💬 " + .text
          elif .type == "tool_use" then
            "🔧 " + .name + ": " + (.input | tostring | .[0:150])
          else empty end
        elif .type == "user" then
          .message.content[]? |
          if .type == "tool_result" then
            "📋 " + (.content | tostring | .[0:200])
          else empty end
        else empty end
      '
      ;;

    codex)
      codex exec \
        --json \
        --dangerously-bypass-approvals-and-sandbox \
        --skip-git-repo-check \
        -m "$model" \
        -c model_reasoning_effort="xhigh" \
        "$prompt" </dev/null 2>/dev/null \
      | jq --unbuffered -r '
        if .type == "item.completed" then
          .item as $i |
          if $i.type == "agent_message" then
            "💬 " + ($i.text // "")
          elif $i.type == "command_execution" then
            "🔧 shell: " + (($i.command // "") | tostring | .[0:150])
              + "\n📋 [exit " + (($i.exit_code // "?") | tostring) + "] "
              + (($i.aggregated_output // "") | tostring | .[0:200])
          elif $i.type == "file_change" then
            "🔧 file_change: " + (($i.changes // []) | map((.kind // "?") + " " + (.path // "?")) | join(", "))
          else empty end
        elif .type == "turn.failed" then
          "⚠️  turn.failed: " + ((.error.message // "") | tostring | .[0:200])
        elif .type == "error" then
          "⚠️  error: " + ((.message // "") | tostring | .[0:200])
        else empty end
      '
      ;;

    opencode)
      opencode run \
        --format json \
        --dangerously-skip-permissions \
        --model "$model" \
        --variant max \
        --print-logs --log-level ERROR \
        "$prompt" </dev/null 2>/dev/null \
      | jq --unbuffered -r '
        if .type == "text" then
          "💬 " + ((.part.text // .text // "") | tostring)
        elif .type == "tool_use" then
          .part as $p |
          if ($p.state.status // "") == "completed" then
            "🔧 " + ($p.tool // "?") + ": " + (($p.state.input // {}) | tostring | .[0:150])
              + "\n📋 " + (($p.state.output // "") | tostring | .[0:200])
          else empty end
        elif .type == "step_finish" then
          "✅ step_finish reason=" + ((.part.reason // "?") | tostring)
            + " tokens(in=" + ((.part.tokens.input // 0) | tostring)
            + " out=" + ((.part.tokens.output // 0) | tostring) + ")"
        elif .type == "step_start" then
          "▶️  step_start"
        elif .type == "error" then
          "⚠️  error: " + ((.error.data.message // .error.message // .error.name // "") | tostring | .[0:300])
        else empty end
      '
      ;;

    gh)
      # The copilot CLI has no --cwd flag; we already cd-ed into WORK_DIR above.
      # Schema for --output-format json is undocumented and shifting; we
      # extract best-effort and fall back to printing the raw line.
      copilot -p "$prompt" \
        --allow-all-tools --allow-all-paths --allow-all-urls \
        --add-dir "$(pwd)" \
        --model "$model" \
        --effort high \
        --output-format json \
        --no-color </dev/null 2>/dev/null \
      | jq --unbuffered -r '
        . as $e |
        (.type // .event // "") as $t |
        if $t == "assistant.message" then
          "💬 " + ((.data.content // "") | tostring)
        elif ($t == "assistant.message_delta") then
          empty
        elif ($t == "result") then
          "✅ result exit=" + ((.exitCode // .data.exitCode // "?") | tostring)
        elif ($t == "assistant" or $t == "message" or $t == "text") then
          "💬 " + ((.text // .content // "") | tostring)
        elif ($t == "tool_use" or $t == "tool_call" or $t == "tool.call") then
          "🔧 " + ((.name // .tool // "?") | tostring) + ": "
            + (((.input // .arguments // {}) | tostring) | .[0:150])
        elif ($t == "tool_result" or $t == "tool.result") then
          "📋 " + (((.output // .content // "") | tostring) | .[0:200])
        elif ($t == "error" or .error) then
          "⚠️  " + (((.error // .message // "") | tostring) | .[0:200])
        elif ($t | startswith("session.")) or ($t == "user.message") or ($t == "assistant.turn_start") or ($t == "assistant.turn_end") or ($t == "assistant.message_start") then
          empty
        else
          "ℹ️  " + ($e | tostring | .[0:200])
        end
      '
      ;;

    *)
      echo "Unknown harness: $harness" >&2
      return 1
      ;;
  esac
}

# Change to working directory if specified
if [ -n "$WORK_DIR" ]; then
  cd "$WORK_DIR" || { echo "Error: cannot cd to $WORK_DIR"; exit 1; }
fi

log "🚀 Ralph '$RALPH_NAME' started (harness=$HARNESS, model=$MODEL, max_runs=$MAX_RUNS, dir=$(pwd))"
log "📝 Prompt: ${PROMPT:0:120}$([ ${#PROMPT} -gt 120 ] && echo '...')"
[ "$NO_LOG" = false ] && log "📄 Log: $LOG_FILE"

RUN_COUNT=0
RUNS_COMPLETED=0

while true; do
  RUN_COUNT=$((RUN_COUNT + 1))

  if [ "$MAX_RUNS" -gt 0 ] && [ "$RUN_COUNT" -gt "$MAX_RUNS" ]; then
    log "✅ Reached max runs ($MAX_RUNS). Stopping."
    break
  fi

  log "--- RUN $RUN_COUNT$([ "$MAX_RUNS" -gt 0 ] && echo "/$MAX_RUNS") ---"

  # Update meta with current run
  sed -i "s/^current_run=.*/current_run=$RUN_COUNT/" "$META_FILE" 2>/dev/null \
    || echo "current_run=$RUN_COUNT" >> "$META_FILE"

  OUTPUT_TMP=$(mktemp)
  run_harness "$HARNESS" "$MODEL" "$PROMPT" \
  | if [ "$NO_LOG" = false ]; then
    tee -a "$LOG_FILE" "$OUTPUT_TMP"
  else
    tee "$OUTPUT_TMP"
  fi
  OUTPUT=$(<"$OUTPUT_TMP")
  rm -f "$OUTPUT_TMP"

  log "--- RUN $RUN_COUNT COMPLETE ---"
  RUNS_COMPLETED=$RUN_COUNT

  # Check for errors
  if echo "$OUTPUT" | grep -q "You've hit your limit"; then
    if [ "$MARATHON" = true ]; then
      log "⏳ Rate limited. Sleeping 30 minutes..."
      sleep "$RATE_LIMIT_SLEEP" &
      wait $!
    else
      log "⚠️  Rate limited. Use --marathon to auto-retry. Stopping."
      break
    fi
  elif echo "$OUTPUT" | grep -qi "error\|fatal\|panic"; then
    log "⚠️  Possible error detected in output (continuing anyway)"
  fi

  sleep 2 &
  wait $!
done

cleanup
